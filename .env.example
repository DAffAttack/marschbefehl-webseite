# Umgebungsvariablen des Buchungssystems (Vorlage, keine echten Werte).
# Lokal: Kopie als .env (wird von netlify dev geladen, liegt nicht im Repo).
# Netlify: Site configuration -> Environment variables.

# --- Verwaltung ---
FUEHRUNGEN_ADMIN_PASSWORD=        # Passwort für fuehrungen-verwaltung.html (Pflicht)
ADMIN_SITZUNG_GEHEIMNIS=          # optional: langer Zufallswert zum Signieren der Sitzungs-Cookies (sonst vom Passwort abgeleitet)

# --- Zahlung (Stripe) ---
STRIPE_SECRET_KEY=                # sk_test_... (Testmodus) bzw. sk_live_... (Livegang); fehlt er lokal, läuft die Zahlungs-Attrappe
STRIPE_WEBHOOK_SECRET=            # whsec_... aus dem Stripe-Webhook für /.netlify/functions/stripe-webhook
ZAHLUNGSARTEN=card,paypal         # Zahlungsarten auf der Bezahlseite (card = Karte + Apple Pay + Google Pay). PayPal muss im Stripe-Konto aktiv sein, sonst nur "card"

# --- Mail (Resend) ---
RESEND_API_KEY=                   # re_...; fehlt er lokal, läuft die Mail-Attrappe (.netlify/mail-ausgang)
MAIL_ABSENDER=Zeitreise Seelower Höhen <buchung@marschbefehl.com>
MAIL_ANTWORT_AN=mail.zsh@proton.me
MAIL_KOPIE_AN=                    # eigene Adresse für "Neue Buchung" und Abgleich-Meldungen

# Zello-Anleitung in Bestätigung und Erinnerung; fehlt ein Wert, steht dort "am Treffpunkt"
ZELLO_KANAL=
ZELLO_PASSWORT=

# --- Rechnung ---
RECHNUNG_ABSENDER_NAME=Enrico Holland
RECHNUNG_ABSENDER_MARKE=Zeitreise Seelower Höhen
RECHNUNG_ABSENDER_STRASSE=Breite Straße 36
RECHNUNG_ABSENDER_ORT=15306 Seelow
RECHNUNG_ABSENDER_EMAIL=mail.zsh@proton.me
RECHNUNG_STEUERNUMMER=            # sobald vom Finanzamt vergeben

# --- Nur lokal für Prüfläufe ---
BUCHUNG_BREMSE_JE_STUNDE=1000     # Buchungsversuche je IP und Stunde (Vorgabe 10)
