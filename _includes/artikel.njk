<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ seitentitel or titel }} – Zeitreise Seelower Höhen</title>
<meta name="description" content="{{ beschreibung }}">
<link rel="canonical" href="https://marschbefehl.com{{ page.url }}">

{# Soziale Netzwerke und Suchmaschinen — fehlte den handgeschriebenen Artikeln komplett #}
<meta property="og:type" content="article">
<meta property="og:title" content="{{ titel }}">
<meta property="og:description" content="{{ beschreibung }}">
<meta property="og:url" content="https://marschbefehl.com{{ page.url }}">
{% if bild %}<meta property="og:image" content="https://marschbefehl.com{{ bild }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">

<link rel="alternate" type="application/rss+xml" title="Zeitreise Seelower Höhen — Artikel" href="/feed.xml">
<link rel="stylesheet" href="/assets/nav.css">
<link rel="stylesheet" href="/assets/artikel.css">
<script defer src="/assets/site-chrome.js"></script>

{# Strukturierte Daten: sagt Google, dass dies ein Artikel mit Datum und Autor ist #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ titel | dump | safe }},
  "description": {{ beschreibung | dump | safe }},
  "datePublished": "{{ datum | datumIso }}",
  "author": { "@type": "Person", "name": "Enrico Holland" },
  "publisher": { "@type": "Organization", "name": "Zeitreise Seelower Höhen" },
  "mainEntityOfPage": "https://marschbefehl.com{{ page.url }}"{% if bild %},
  "image": "https://marschbefehl.com{{ bild }}"{% endif %}
}
</script>
</head>
<body>

<header id="site-header"></header>

<section class="hero">
  <canvas id="terrain-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <p class="eyebrow">{{ eyebrow }}</p>
    <h1>{{ titel }}</h1>
    <p>{{ heroText }}</p>
    <div class="scroll-cue" aria-hidden="true"></div>
  </div>
</section>

{{ content | vorspann | safe }}

<main class="article">
  <p class="lead">{{ lead }}</p>
{{ content | kapitel | safe }}
</main>

{% if youtubeId %}
<div class="video-cta">
  <p class="label">{{ ctaLabel or "Die vollständige Dokumentation" }}</p>
  <a href="https://www.youtube.com/watch?v={{ youtubeId }}" target="_blank" rel="noopener">
    <div class="thumb-wrap">
      <img src="/assets/artikel/yt-{{ youtubeId }}.jpg" alt="" loading="lazy">
      <div class="play"><span>
        <svg viewBox="0 0 24 24" fill="none"><path d="M9 8L16 12L9 16V8Z" fill="currentColor"/></svg>
      </span></div>
    </div>
    <div class="vtext">
      <p class="vtitle">{{ youtubeTitel or titel }}</p>
      <p class="vsub">Auf YouTube ansehen →</p>
    </div>
  </a>
</div>
{% endif %}

{{ content | nachspann | safe }}

<div class="back-links">
  <a href="/artikel/">&#8592; Alle Artikel</a>
  <a href="/quellen.html">Alle Quellen &amp; Buchtipps &#8594;</a>
</div>

<footer>
  <div>&copy; 2026 Zeitreise Seelower Höhen</div>
  <div style="margin-top:10px;">
    <a href="/impressum.html">Impressum</a> &nbsp;·&nbsp; <a href="/datenschutz.html">Datenschutz</a>
  </div>
</footer>

<script src="/assets/vendor/three.min.js"></script>
<script src="/assets/vendor/gsap.min.js"></script>
<script src="/assets/vendor/ScrollTrigger.min.js"></script>
<script defer src="/assets/artikel.js"></script>
<script>
(function(){
  // GoatCounter nur auf der echten Domain zaehlen, nicht auf Vorschau-/Test-
  // Adressen (Netlify-Branch-Deploys, localhost, etc.) -- sonst zaehlen Tests
  // und geteilte Vorschau-Links als echte Besuche in der Statistik mit.
  if(!/(^|\.)marschbefehl\.com$/.test(location.hostname)) return;
  var s = document.createElement('script');
  s.async = true;
  s.src = '//gc.zgo.at/count.js';
  s.setAttribute('data-goatcounter', 'https://marschbefehl.goatcounter.com/count');
  document.body.appendChild(s);
})();
</script>
</body>
</html>
